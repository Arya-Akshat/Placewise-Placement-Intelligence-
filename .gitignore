# =============================================================================
# PLACEWISE — Comprehensive .gitignore
# =============================================================================

# --- Sensitive Environment & Secrets ---
.env
*.env
*.env.local
*.env.production
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
*.pem
*.key
*.token
*.secret

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo

# --- Large Binary Data & Database Files (>100MB Git Limit) ---
data/*.duckdb
data/*.duckdb.wal
data/*.db
data/*.sqlite
*.duckdb
*.duckdb.wal
data/conversations.db
placement_Data/*.csv
placement_Data/*.zip
data/synthetic/*.csv

# --- Logs & Temp ---
*.log
logs/
temp/
tmp/
*.tmp

# --- OS & Editor Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.gemini/
.agents/
